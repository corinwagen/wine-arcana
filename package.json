{
  "name": "wine-arcana",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "article:next": "node scripts/run-next-article.js",
    "build:site": "node scripts/build-site.js",
    "check": "npm run lint:markdown && npm run test && npm run validate && npm run validate:images && npm run build:site",
    "format:markdown": "rumdl fmt .",
    "images:search": "node scripts/search-images.js",
    "lint:markdown": "rumdl check . --no-cache",
    "test": "node --test",
    "validate": "node scripts/validate-content.js",
    "validate:images": "node scripts/validate-images.js"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "markdown-it-footnote": "^4.0.0",
    "yaml": "^2.9.0"
  }
}
